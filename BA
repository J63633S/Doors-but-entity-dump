-- ====== FIXED ACCELERATION MECHANISM VIA DIRECT COMPONENT OVERWRITE ======
entity:SetCallback("OnRebounding", function(startOfRebound: boolean)
    if startOfRebound == false then
        print("entity did rebound")
        current_speed = current_speed + SPEED_INCREMENT
        
        -- 1. Hard-override the config tables fallback paths
        if rawget(entity, "Config") and entity.Config.Movement then
            entity.Config.Movement.Speed = current_speed
        end
        if rawget(entity, "Movement") then
            entity.Movement.Speed = current_speed
        end
        
        -- 2. Direct Physical Modification: Find the moving entity asset in workspace and force-inject velocity overrides
        task.spawn(function()
            -- Small delay ensures the engine has flipped the model around for the next run step
            task.wait(0.02) 
            
            for _, child in ipairs(workspace:GetChildren()) do
                -- Locates the physical asset created by Vynixu matching your configuration name
                if child.Name == "BA" or child:FindFirstChild("Rush") or child:FindFirstChild("RushPhysics") then
                    
                    -- Scans the moving model for the structural constraints controlling its runtime speed vector
                    for _, desc in ipairs(child:GetDescendants()) do
                        if desc:IsA("LinearVelocity") then
                            desc.VectorVelocity = desc.VectorVelocity.Unit * current_speed
                        elseif desc:IsA("BodyVelocity") then
                            desc.Velocity = desc.Velocity.Unit * current_speed
                        elseif desc:IsA("NumberValue") and (desc.Name:lower():match("speed") or desc.Name == "CurrentSpeed") then
                            desc.Value = current_speed
                        end
                    end
                    
                end
            end
        end)
	end
end)

entity:SetCallback("OnDespawning", function()
    print("Entity is despawning - triggering isolated orange light overlay")
    
    local orangeColor = Color3.fromRGB(0, 0, 255)
    
    Lighting.Ambient = orangeColor
    Lighting.OutdoorAmbient = orangeColor
    Lighting.ColorShift_Top = orangeColor
    
    local temporaryLightParts = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Light") then
            table.insert(temporaryLightParts, {instance = obj, original = obj.Color})
            obj.Color = orangeColor
        elseif obj:IsA("BasePart") and (obj.Name:lower():match("light") or obj.Name:lower():match("glow") or obj.Material == Enum.Material.Neon) then
            table.insert(temporaryLightParts, {instance = obj, original = obj.Color})
            obj.Color = orangeColor
        end
    end
    
    task.delay(4.5, function()
        Lighting.Ambient = originalAmbient
        Lighting.OutdoorAmbient = originalOutdoorAmbient
        Lighting.ColorShift_Top = originalColorShift
        
        for _, entry in ipairs(temporaryLightParts) do
            if entry.instance and entry.instance.Parent then
                entry.instance.Color = entry.original
            end
        end
        print("Lighting successfully restored to room baselines.")
    end)
end)


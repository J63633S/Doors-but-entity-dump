local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

-- Configuration
local BASE_FOG_COLOR = Color3.fromRGB(15, 25, 40) -- Dark atmospheric blue
local BASE_AMBIENT = Color3.fromRGB(10, 12, 18)    -- Very dark blue ambient light
local LIGHTNING_COLOR = Color3.fromRGB(35, 45, 65)  -- Dim, dark blue-grey lightning flash

local function setupAtmosphere()
	Lighting.ClockTime = 0 -- Sets time to midnight
	Lighting.Brightness = 0
	
	-- Fog Settings
	Lighting.FogColor = BASE_FOG_COLOR
	Lighting.FogStart = 0
	Lighting.FogEnd = 45 -- Low number makes the fog dense and close
	
	-- Ambient Settings
	Lighting.Ambient = BASE_AMBIENT
	Lighting.OutdoorAmbient = BASE_AMBIENT
end

local function triggerLightning()
	-- Quick flash to a darker lightning color
	Lighting.Ambient = LIGHTNING_COLOR
	Lighting.OutdoorAmbient = LIGHTNING_COLOR
	Lighting.FogColor = Color3.fromRGB(25, 35, 50) -- Slightly brightened fog
	
	task.wait(math.random(0.05, 0.15)) -- Flash duration
	
	-- Return to normal dark settings using a smooth tween
	local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local goal = {
		Ambient = BASE_AMBIENT,
		OutdoorAmbient = BASE_AMBIENT,
		FogColor = BASE_FOG_COLOR
	}
	
	local tween = TweenService:Create(Lighting, tweenInfo, goal)
	tween:Play()
end

-- Initialize the environment
setupAtmosphere()


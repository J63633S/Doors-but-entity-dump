task.spawn(function()
	while true do
		task.wait(math.random(6, 15)) -- Time between strikes
		triggerLightning()
		
		-- 30% chance for a double lightning strike
		if math.random() < 0.3 then
			task.wait(0.2)
			triggerLightning()
		end
	end
end)


-- Shared state variable to track if the entity is active
local entityActive = false

---====== Debug entity ======---

entity:SetCallback("OnSpawned", function()
    print("Entity has spawned")
    entityActive = true -- Mark entity as active
end)

entity:SetCallback("OnStartMoving", function()
    print("Entity has started moving")
    local Players = game:GetService("Players")
    local localPlayer = Players.LocalPlayer

    local COOLDOWN_TIME = 1.0 -- Cooldown in seconds
    local isOnCooldown = false

    -- Function that handles the character loop
    local function monitorCharacter(character)
        local humanoid = character:WaitForChild("Humanoid")
        
        -- Loop runs only while the character is valid, alive, AND the entity is active
        while character:IsDescendantOf(workspace) and humanoid.Health > 0 and entityActive do
            task.wait(0.1) -- Fast polling rate to check the attribute
            
            -- Extra safety break check in case entityActive changes during task.wait
            if not entityActive then break end

            if character:GetAttribute("Crouching") ~= true and not isOnCooldown then
                isOnCooldown = true
                
                -- Take damage safely
                humanoid.Health = math.max(0, humanoid.Health - 5)
                
                -- Wait for the cooldown to expire, then reset the switch
                task.wait(COOLDOWN_TIME)
                isOnCooldown = false
            end
        end
    end

    -- Run for current character if it already exists
    if localPlayer.Character then
        task.spawn(monitorCharacter, localPlayer.Character)
    end

    -- Run every time the player respawns
    localPlayer.CharacterAdded:Connect(monitorCharacter)
end)

entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
    if firstTime == true then
        print("Entity has entered room: ".. room.Name.. " for the first time")
    else
        print("Entity has entered room: ".. room.Name.. " again")
    end
end)

entity:SetCallback("OnLookAt", function(lineOfSight: boolean)
	if lineOfSight == true then
		print("Player is looking at entity")
	else
		print("Player view is obstructed by something")
	end
end)

entity:SetCallback("OnRebounding", function(startOfRebound: boolean)
    if startOfRebound == true then
        print("Entity has started rebounding")
	else
        print("Entity has finished rebounding")
	end
end)

entity:SetCallback("OnDespawning", function()
    print("Entity is despawning")
end)

entity:SetCallback("OnDespawned", function()
    print("Entity has despawned")
    entityActive = false -- Instantly shuts down the crouching check loops
end)

entity:SetCallback("OnDamagePlayer", function(newHealth: number)
	if newHealth <= 0 then
		print("Entity has killed the player")
	else
		print("Entity has damaged the player")
	end
end)

---====== Run entity ======---

entity:Run(true)
